[
  {
    "UpdateStageName": "Download Relay",
    "UpdateSourcePlatform": "Linux",
    "UpdateSourceArch": "x86_64",
    "UpdateSource": "FetchURL",
    "UpdateSourceData": "{{PackageURL}}",
    "UpdateSourceTarget": "{{$FullBaseDir}}",
    "UnzipUpdateSource": true,
    "OverwriteExistingFiles": true,
    "DeleteAfterExtract": true,
    "SkipOnFailure": false
  },
  {
    "UpdateStageName": "Make Relay Executable",
    "UpdateSourcePlatform": "Linux",
    "UpdateSourceArch": "x86_64",
    "UpdateSource": "Executable",
    "UpdateSourceData": "/bin/chmod",
    "UpdateSourceArgs": "+x {{$FullBaseDir}}relay-server",
    "SkipOnFailure": false
  }
]
