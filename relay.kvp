Meta.DisplayName=Relay
Meta.Description=Private, persistent real-time text chat
Meta.OS=Linux
Meta.AarchSupport=Native
Meta.Arch=x86_64
Meta.Author=Private Template
Meta.URL=https://github.com/CubeCoders/AMP/wiki/Configuring-the-%27Generic%27-AMP-module
Meta.DisplayImageSource=none:
Meta.EndpointURIFormat=http://{ip}:{GenericModule.App.Ports.$ServerPort}
Meta.ConfigManifest=relayconfig.json
Meta.MetaConfigManifest=relaymetaconfig.json
Meta.ConfigRoot=relay.kvp
Meta.MinAMPVersion=2.6.2.6
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=10
Meta.ReleaseNotes=Relay 0.4.0 adds the versioned client API, user-scoped realtime events, conversation-based global history, and a modular embedded web client while preserving legacy routes.
Meta.BreakingReleaseNotes=
Meta.AppConfigId=8b6b52c3-9f67-4d50-a433-2cc5f7c23d15
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False
App.DisplayName=Relay
App.RootDir=./relay/
App.BaseDirectory=./relay/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=
App.ExecutableLinux=relay-server
App.WorkingDir=
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=--config relay.json --listen {{$ApplicationIPBinding}} --port {{$ServerPort}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"RELAY_SUPABASE_URL":"{{SupabaseURL}}","RELAY_SUPABASE_PUBLISHABLE_KEY":"{{SupabasePublishableKey}}"}
App.CommandLineParameterFormat=--{0} {1}
App.CommandLineParameterDelimiter=
App.ExitMethod=String
App.ExitTimeout=30
App.ExitString=stop
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=
App.ForceIPBinding=False
App.SupportsIPv6=True
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[relayports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=ServerPort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers={{MaxConnections}}
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=
App.TelnetLoginFormat={0}
App.UpdateSources=@IncludeJson[relayupdates.json]
App.PreStartStages=[]
App.UserActions=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=LinuxBufferedConsole
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.RapidStartup=True
App.SmartExcludeExemptions=[]
App.SmartExcludeSupported=False
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=
App.MonitorDirectChildOnly=False
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=
Console.AppReadyRegex=^RELAY READY(?: .*)?$
Console.UserJoinRegex=^.*USER CONNECTED username=(?<username>.+)$
Console.UserLeaveRegex=^.*USER DISCONNECTED username=(?<username>.+)$
Console.UserChatRegex=^$
Console.ServerInfoRegex=^.*EVENT type=(?<event>[a-z_]+) detail=(?<details>.*)$
Console.UpdateAvailableRegex=^$
Console.PreConnectRegex=
Console.ConnectIPRegex=
Console.MetricsRegex=
Console.HideFromConsoleRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
